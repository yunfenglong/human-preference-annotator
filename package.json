{
  "name": "human-preference-annotator",
  "version": "1.0.0",
  "description": "Human Preference Annotator deployed as a Cloudflare Worker with D1 and R2.",
  "type": "module",
  "main": "worker/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file ./seed.local.sql",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check": "wrangler deploy --dry-run",
    "test": "node --test tests/*.test.mjs",
    "study:import": "node scripts/import_sk_tasks.mjs"
  },
  "keywords": [
    "annotation",
    "cloudflare-workers",
    "d1",
    "r2",
    "human-preference",
    "driving"
  ],
  "author": "Junkai Li",
  "license": "MIT",
  "devDependencies": {
    "miniflare": "5.20260930.0-alpha",
    "wrangler": "^4.145.0"
  }
}

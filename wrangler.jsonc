{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "human-preference-annotator",
  "account_id": "e9344ea46241821b1d81c59a18c7478e",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/videos/*",
      "/healthz"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "human-preference-annotator",
      "database_id": "31a0a8d2-6354-4f41-892e-c0733ed901fc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "human-preference-videos"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "human-preference-annotator-quest-preview",
        "database_id": "3cb3dc46-3070-4312-8b88-e9da5c137cc9",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      {
        "binding": "VIDEOS",
        "bucket_name": "human-preference-videos"
      }
    ]
  }
}
